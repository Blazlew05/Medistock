# Base de datos (Postgres). Si corres backend_django con Docker Compose, el
# servicio ya inyecta DB_HOST=db automáticamente; usa localhost solo si corres
# manage.py fuera de Docker apuntando al Postgres levantado con `docker compose up -d db`.
DB_NAME=medistock
DB_USER=medistock
DB_PASSWORD=medistock123
DB_HOST=localhost
DB_PORT=5432

# Django / JWT
SECRET_KEY=django-insecure-cambia-esto-en-produccion
DEBUG=True
ALLOWED_HOSTS=*
ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_ALGORITHM=HS256

# MercadoPago Chile (sandbox) - https://www.mercadopago.cl/developers/panel/app
MERCADOPAGO_ACCESS_TOKEN=TEST-0000000000000000-000000-00000000000000000000000000000000-000000000
MERCADOPAGO_PUBLIC_KEY=TEST-00000000-0000-0000-0000-000000000000

# Transbank Webpay Plus (vacío = usa credenciales de integración/sandbox por defecto)
WEBPAY_COMMERCE_CODE=
WEBPAY_API_KEY=

# URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# CORS (separados por coma)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:3001
